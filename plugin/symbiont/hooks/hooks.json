{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/symbiont-hook.sh\" SessionStart || %CLAUDE_PLUGIN_ROOT%\\bin\\symbiont-hook.cmd SessionStart",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/symbiont-hook.sh\" UserPromptSubmit || %CLAUDE_PLUGIN_ROOT%\\bin\\symbiont-hook.cmd UserPromptSubmit",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/symbiont-hook.sh\" PostToolUse || %CLAUDE_PLUGIN_ROOT%\\bin\\symbiont-hook.cmd PostToolUse",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/symbiont-hook.sh\" PostToolUseFailure || %CLAUDE_PLUGIN_ROOT%\\bin\\symbiont-hook.cmd PostToolUseFailure",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/symbiont-hook.sh\" Stop || %CLAUDE_PLUGIN_ROOT%\\bin\\symbiont-hook.cmd Stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
