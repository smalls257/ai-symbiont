{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_paths.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint_edited_file.sh"
          }
        ]
      }
    ]
  }
}
