{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "demo-headlines-v1",
 "title": "Measured headline numbers for the demo results strip",
 "$comment": "Every row carries a role; a fly row needs counters beside it.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "source", "headlines"],
 "properties": {
  "schema": {"const": "demo-headlines-v1"},
  "source": {"type": "string", "minLength": 1},
  "headlines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/headline"}}
 },
 "$defs": {
  "headline": {
   "type": "object",
   "additionalProperties": false,
   "required": ["id", "label", "status", "unit", "source", "verdict", "note", "rows"],
   "properties": {
    "id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "status": {"enum": ["measured", "established", "hypothesis"]},
    "unit": {"type": "string", "minLength": 1},
    "source": {"type": "string", "pattern": "^results/[a-z0-9-]+\\.json"},
    "verdict": {"type": "string", "minLength": 1},
    "note": {"type": "string", "minLength": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
   }
  },
  "row": {
   "type": "object",
   "additionalProperties": false,
   "required": ["label", "role", "value", "ci95_low", "ci95_high"],
   "properties": {
    "label": {"type": "string", "minLength": 1},
    "role": {"enum": ["floor", "ceiling", "reference", "under test"]},
    "value": {"type": "number"},
    "ci95_low": {"type": ["number", "null"]},
    "ci95_high": {"type": ["number", "null"]}
   }
  }
 }
}
