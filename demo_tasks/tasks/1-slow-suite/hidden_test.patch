@@ -0,0 +1,28 @@
+"""Invoices on a bucket's last day stay in that bucket."""
+
+from datetime import date, timedelta
+from decimal import Decimal
+
+import pytest
+
+from ledgerline.statement import OpenInvoice, aging_label, aging_report
+
+AS_OF = date(2024, 6, 30)
+
+
+@pytest.mark.parametrize(
+    ("days", "label"),
+    [(1, "1-30"), (30, "1-30"), (31, "31-60"), (60, "31-60"), (61, "61-90"), (90, "61-90"),
+     (91, "90+")],
+)
+def test_aging_label_on_bucket_edges(days, label):
+    """The last day of a bucket belongs to it; the next day starts the next one."""
+    assert aging_label(days) == label
+
+
+def test_invoice_thirty_days_late_is_reported_in_first_bucket():
+    """Due 2024-05-31, statement on 2024-06-30: 30 days late, bucket 1-30."""
+    invoice = OpenInvoice("INV-30", AS_OF - timedelta(days=30), Decimal("250.00"))
+    report = aging_report([invoice], AS_OF)
+    assert report["1-30"] == Decimal("250.00")
+    assert report["31-60"] == Decimal(0)
