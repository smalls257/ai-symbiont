# Placeholders only (example.invalid never resolves). Copy to a private env file outside the
# repo and export it; never commit real addresses (QG-SEC-05). The filename avoids the .env*
# publish block in check_paths.sh.
# Only runs that call Muse Spark (api.meta.ai) need a key; the keyless demo needs none.
# Export it in your shell or a private file outside the repo; never commit a real key.
META_API_KEY=
# Glimmer llama.cpp endpoint (scripts/calibration/run_calibration.py)
SYMBIONT_GLIMMER_URL=http://glimmer.example.invalid:8081/v1
# Desktop that runs the calibration driver (scripts/calibration/sync_results.sh)
SYMBIONT_DESKTOP_SSH=user@desktop.example.invalid
SYMBIONT_DESKTOP_WORKDIR=/srv/symbiont-work
# Personal Glimmer (base + per-repo LoRA) for the SWE-bench Django run (scripts/swev/swev_run.py);
# the personal arm reads only these two, never the plain endpoint
SYMBIONT_PERSONAL_GLIMMER_URL=http://glimmer.example.invalid:8082/v1
SYMBIONT_PERSONAL_GLIMMER_MODEL=openai/personal-glimmer-django
